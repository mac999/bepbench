      "door": "IfcDoor",
      "window": "IfcWindow",
      "glazing": "IfcWindow",
      "lift": "IfcTransportElement",
      "elevator": "IfcTransportElement",
      "escalator": "IfcTransportElement",
      "duct": "IfcDuctSegment",
      "ductwork": "IfcDuctSegment",
      "pipe": "IfcPipeSegment",
      "pipework": "IfcPipeSegment",
      "valve": "IfcValve",
